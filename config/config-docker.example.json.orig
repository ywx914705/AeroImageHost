{
  "http_port": 8082,
  "max_file_size": 104857600,
  "stats_cache_ttl_seconds": 60,

  "security": {
    "cors_origin": "*",
    "max_login_attempts": 5,
    "max_login_attempts_per_ip": 30,
    "login_window_seconds": 900,
    "max_send_code_requests_per_ip_per_hour": 10,
    "send_code_ip_window_seconds": 3600,
    "admin_user_id": 1
  },

  "files_list": {
    "max_page_size": 100,
    "max_offset": 5000000,
    "max_search_keyword_length": 128
  },

  "cleanup": {
    "multipart_ttl_seconds": 86400
  },

  "mysql": {
    "host": "db",
    "port": 3306,
    "user": "aero_user",
    "password": "aero123456",
    "db": "imagehost",
    "pool_size": 32
  },

  "redis": {
    "host": "redis",
    "port": 6379,
    "pool_size": 16,
    "password": "redis123456"
  },

  "minio": {
    "endpoint": "http://minio:9000",
    "presign_endpoint": "",
    "access_key": "minioadmin",
    "secret_key": "minio123456",
    "bucket": "images",
    "public_url": "http://localhost:8082/api/i/"
  },

  "smtp": {
    "server": "smtp.qq.com",
    "port": 465,
    "username": "CHANGE_ME_smtp_username",
    "password": "CHANGE_ME_smtp_password",
    "from": "CHANGE_ME_smtp_from"
  },

  "log": {
    "file": "/app/logs/server.log",
    "flush_interval": 3
  }
}
